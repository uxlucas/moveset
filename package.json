{
  "name": "moveset",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "tsx --tsconfig tsconfig.scripts.json scripts/generate.ts",
    "dev:watch": "tsx --tsconfig tsconfig.scripts.json scripts/generate.ts --watch",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "checkpoint": "playwright test -c playwright.checkpoint.config.ts",
    "check": "npm run generate && npm run typecheck && npm run test",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
